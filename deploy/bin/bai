#!/usr/bin/env bash
# bai — base-ai RBAC config CLI for the OpenClaw gateway.
#
# Runs on the EC2 host. Manages accessGroups, per-user DM bindings, and
# commands.ownerAllowFrom inside ~/.openclaw/openclaw.json (the file the
# OpenClaw container reads via bind-mount).
#
# See docs/superpowers/specs/2026-05-10-openclaw-slack-rbac-design.md
# for the design this CLI operationalizes.
#
# Usage:
#   bai init                       # bootstrap a skeleton openclaw.json
#   bai init --merge               # add missing pieces to an existing openclaw.json
#                                  # (keeps everything you have; writes .bak first)
#   bai admin    add <UID> [name]  # promote user to Admin tier
#   bai admin    remove <UID>      # demote user from Admin tier
#   bai admin    list              # list current admins
#   bai operator add <UID> [name]  # promote user to Operator tier
#   bai operator remove <UID>      # demote user from Operator tier
#   bai operator list              # list current operators
#   bai viewer   add <UID> [name]  # promote user to Viewer tier
#   bai viewer   remove <UID>      # demote user from Viewer tier
#   bai viewer   list              # list current viewers
#
#   bai whois <UID>                # show which tier(s) a user is in
#   bai tiers                      # summary table of all 3 tiers
#   bai validate                   # check JSON syntax + structural sanity
#   bai migrate                    # one-shot fixup for configs written against
#                                  # the older skeleton (renames base-* → *,
#                                  # fixes botToken/appToken/ownerDisplaySecret
#                                  # shapes, drops invalid execApprovals.enabled,
#                                  # rewrites tools "memory" → "group:memory",
#                                  # strips accessGroup: from per-channel users)
#   bai bootstrap                  # run `openclaw agents add` for admin/ops/view
#                                  # to create workspace bootstrap files (7 .md
#                                  # templates) + sessions dirs. Required after
#                                  # bai migrate before the UI will show them.
#   bai reload                     # validate, then full docker restart of the
#                                  # gateway. Slow (~10s) but reliable —
#                                  # required after adding/removing agents.
#   bai reload --hot               # validate, then `openclaw config reload`
#                                  # (in-process). Fast, but does NOT re-init
#                                  # new agents. Only use for routing/access
#                                  # group/binding changes on existing agents.
#   bai path                       # print path to the config file
#   bai help                       # this help
#
# User IDs are Slack member IDs (U… or W…). Get them in Slack:
#   click profile → "…" menu → "Copy member ID".
# The optional [name] arg is for confirmation echo only — not stored anywhere.
#
# Environment variables:
#   BAI_CONFIG          Override config file path
#                       (default: $HOME/.openclaw/openclaw.json)
#   BAI_COMPOSE_DIR     ea-openclaw clone dir used for reload fallback
#                       (default: $HOME/ea-openclaw)
#
# Requires: bash 4+, jq.

set -euo pipefail

# --- locate config ---
CONFIG_FILE="${BAI_CONFIG:-$HOME/.openclaw/openclaw.json}"
COMPOSE_DIR="${BAI_COMPOSE_DIR:-$HOME/ea-openclaw}"

# Tier metadata (kept in sync with the design spec).
TIERS=(admins operators viewers)
declare -A TIER_AGENT=(
  [admins]="admin"
  [operators]="ops"
  [viewers]="view"
)
declare -A TIER_LABEL=(
  [admins]="Admin"
  [operators]="Operator"
  [viewers]="Viewer"
)

# --- helpers ---

die() { echo "bai: $*" >&2; exit 1; }

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required but not installed (brew install jq)"
}

require_config() {
  [[ -f "$CONFIG_FILE" ]] || die "config not found at $CONFIG_FILE — run 'bai init' first"
  jq -e . "$CONFIG_FILE" >/dev/null 2>&1 || die "config at $CONFIG_FILE is not valid JSON"
}

validate_user_id() {
  local uid="$1"
  [[ "$uid" =~ ^[UW][A-Z0-9]+$ ]] || die "invalid Slack user ID '$uid' (expected /^[UW][A-Z0-9]+\$/)"
}

# Atomic JSON write: jq → tempfile → mv. Validates structure on the way.
write_json() {
  local jq_program="$1"
  shift
  local tmp
  tmp="$(mktemp -t bai.XXXXXX)"
  trap 'rm -f "$tmp"' RETURN
  if ! jq "$@" "$jq_program" "$CONFIG_FILE" > "$tmp"; then
    die "jq transformation failed; config not modified"
  fi
  jq -e . "$tmp" >/dev/null || die "jq output is not valid JSON; config not modified"
  mv "$tmp" "$CONFIG_FILE"
  trap - RETURN
}

# Resolve the canonical "slack:UID" prefix used in commands.ownerAllowFrom.
prefixed_slack_id() { echo "slack:$1"; }

# --- subcommand: init ---

cmd_init() {
  local mode="create"     # create | force | merge
  case "${1:-}" in
    --force) mode="force"; shift ;;
    --merge) mode="merge"; shift ;;
    "") : ;;
    *) die "unknown 'init' flag: ${1} (try --force or --merge)" ;;
  esac

  if [[ -f "$CONFIG_FILE" && "$mode" == "create" ]]; then
    die "$CONFIG_FILE already exists — pass --merge to add missing pieces only, or --force to overwrite"
  fi
  if [[ ! -f "$CONFIG_FILE" && "$mode" == "merge" ]]; then
    die "$CONFIG_FILE does not exist — run 'bai init' (no flag) to bootstrap from scratch"
  fi

  mkdir -p "$(dirname "$CONFIG_FILE")"

  # Write the skeleton to a temp file first. In --merge mode we then merge
  # the existing file ON TOP of the skeleton — anything the user already
  # has wins; only missing keys get filled in from the skeleton.
  local skeleton_tmp
  skeleton_tmp="$(mktemp -t bai.skel.XXXXXX)"
  trap 'rm -f "$skeleton_tmp"' RETURN

  cat > "$skeleton_tmp" <<'JSON'
{
  "accessGroups": {
    "admins":    { "type": "message.senders", "members": { "slack": [] } },
    "operators": { "type": "message.senders", "members": { "slack": [] } },
    "viewers":   { "type": "message.senders", "members": { "slack": [] } }
  },
  "agents": {
    "list": [
      {
        "id": "admin",
        "workspace": "~/.openclaw/workspace-admin",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read","write","edit","exec","apply_patch","browser","sessions_send","group:memory"],
          "elevated": { "enabled": true }
        },
        "systemPromptOverride": "admin: full operator-tier agent for the org. Never assume a sender is an admin without verifying their Slack user ID against the admins accessGroup."
      },
      {
        "id": "ops",
        "workspace": "~/.openclaw/workspace-ops",
        "sandbox": { "mode": "all", "scope": "agent", "workspaceAccess": "rw" },
        "tools": {
          "allow": ["read","write","edit","browser","sessions_send","group:memory"],
          "deny":  ["exec","apply_patch","gateway","cron"]
        },
        "systemPromptOverride": "ops: workflow-automation tier. You can draft, file, and update — but never exec shell, apply patches, or modify gateway config."
      },
      {
        "id": "view",
        "default": true,
        "workspace": "~/.openclaw/workspace-view",
        "sandbox": { "mode": "all", "scope": "agent", "workspaceAccess": "ro" },
        "tools": {
          "allow": ["read","browser","group:memory"],
          "deny":  ["write","edit","exec","apply_patch","sessions_send","gateway","cron"]
        },
        "systemPromptOverride": "view: read-only research/lookup tier. Refuse any state-mutating request and suggest opening a ticket via #base-ai-ops instead."
      }
    ]
  },
  "bindings": [
    { "agentId": "admin", "match": { "channel": "slack", "peer": { "kind": "channel", "id": "REPLACE_WITH_ADMIN_CHANNEL_ID" } } },
    { "agentId": "ops",   "match": { "channel": "slack", "peer": { "kind": "channel", "id": "REPLACE_WITH_OPS_CHANNEL_ID" } } },
    { "agentId": "view",  "match": { "channel": "slack", "peer": { "kind": "channel", "id": "REPLACE_WITH_ASK_CHANNEL_ID" } } },
    { "agentId": "view",  "match": { "channel": "slack", "peer": { "kind": "direct",  "id": "*" } } },
    { "agentId": "view",  "match": { "channel": "slack", "teamId": "REPLACE_WITH_WORKSPACE_ID" } }
  ],
  "channels": {
    "slack": {
      "mode": "socket",
      "botToken":  "${SLACK_BOT_TOKEN}",
      "appToken":  "${SLACK_APP_TOKEN}",
      "dmPolicy":  "allowlist",
      "allowFrom": ["accessGroup:admins", "accessGroup:operators", "accessGroup:viewers"],
      "dm":          { "enabled": true, "groupEnabled": false },
      "groupPolicy": "allowlist",
      "dangerouslyAllowNameMatching": false,
      "replyToMode": "first",
      "thread": {
        "requireExplicitMention": true,
        "historyScope": "thread",
        "inheritParent": false,
        "initialHistoryLimit": 20
      },
      "requireMention": true,
      "allowBots": false,
      "channels": {
        "REPLACE_WITH_ADMIN_CHANNEL_ID": {
          "enabled": true,
          "requireMention": true,
          "systemPrompt": "You are in #base-ai-admin. Treat senders as admin tier. Audit every exec."
        },
        "REPLACE_WITH_OPS_CHANNEL_ID": {
          "enabled": true,
          "requireMention": true,
          "systemPrompt": "You are in #base-ai-ops. No exec, no apply_patch — refuse and suggest DMing an admin."
        },
        "REPLACE_WITH_ASK_CHANNEL_ID": {
          "enabled": true,
          "requireMention": true,
          "systemPrompt": "You are in #base-ai-ask. Read-only Q&A only. Refuse write requests and link to #base-ai-ops."
        }
      },
      "execApprovals": {
        "approvers": ["accessGroup:admins"],
        "target": "dm"
      },
      "ackReaction": "eyes",
      "typingReaction": "hourglass_flowing_sand"
    }
  },
  "commands": {
    "ownerAllowFrom": [],
    "useAccessGroups": true,
    "ownerDisplay": "hash",
    "ownerDisplaySecret": "REPLACE_WITH_OWNER_DISPLAY_HMAC_KEY"
  }
}
JSON
  jq -e . "$skeleton_tmp" >/dev/null || die "init produced invalid JSON skeleton (this is a bug — please report)"

  local out_tmp
  out_tmp="$(mktemp -t bai.out.XXXXXX)"
  trap 'rm -f "$skeleton_tmp" "$out_tmp"' RETURN

  if [[ "$mode" == "merge" ]]; then
    # jq's `*` is a recursive merge. (skeleton * existing) means: start with
    # the skeleton, then overlay the existing config on top — existing values
    # win on conflicts, missing keys are filled in from the skeleton.
    # Net effect: nothing the user has is lost; only gaps are filled.
    #
    # Caveat: jq's `*` does NOT deep-merge arrays — it picks the right-hand
    # side wholesale. We work around that below for agents.list, where the
    # admin/ops/view agents would otherwise be lost if the user already
    # has any agents at all.
    local backup="$CONFIG_FILE.bak.$(date +%Y%m%d-%H%M%S)"
    cp "$CONFIG_FILE" "$backup"
    if ! jq -s '
      .[0] as $skel | .[1] as $existing
      | ($skel * $existing) as $merged
      # Append any base-* agents from the skeleton that the merged result
      # doesn'\''t already have (matched by id).
      | $merged
      | .agents.list = (
          (.agents.list // []) as $current
          | ($skel.agents.list // []) as $skel_agents
          | $current
            + ($skel_agents | map(select(.id as $id | $current | map(.id) | index($id) | not)))
        )
    ' "$skeleton_tmp" "$CONFIG_FILE" > "$out_tmp"; then
      die "merge failed; original config left at $CONFIG_FILE (backup at $backup)"
    fi
    jq -e . "$out_tmp" >/dev/null || die "merge produced invalid JSON; original config preserved"
    mv "$out_tmp" "$CONFIG_FILE"
    echo "bai: merged skeleton into $CONFIG_FILE"
    echo "     backup: $backup"
    echo
    echo "What --merge did:"
    echo "  • kept everything you already had (tokens, agents, channels, model"
    echo "    providers, etc. — untouched)"
    echo "  • filled in top-level keys you didn't have: accessGroups, commands,"
    echo "    execApprovals, etc."
    echo
    echo "What --merge handled for arrays (jq's '*' doesn't deep-merge them):"
    echo "  • agents.list — any of 'admin', 'ops', 'view' that"
    echo "    weren't in your existing list got appended (matched by id)."
    echo
    echo "What --merge could NOT do automatically:"
    echo "  • bindings — if you already had bindings, they were left as-is. You"
    echo "    likely need to add per-channel + DM-wildcard bindings."
    echo "  • channels.slack.channels — per-channel blocks may be missing."
    echo
    echo "Run 'bai validate' for an actionable punch list of what's still missing,"
    echo "or diff against the skeleton:"
    echo "  diff <(jq . $backup) <(jq . $CONFIG_FILE)"
  else
    mv "$skeleton_tmp" "$CONFIG_FILE"
    echo "bai: wrote skeleton to $CONFIG_FILE"
    echo
    echo "Next steps:"
    echo "  1. Edit the config to replace REPLACE_WITH_… placeholders"
    echo "     with real Slack workspace and channel IDs."
    echo "  2. bai admin add <UID>     # at least one admin"
    echo "  3. bai operator add <UID>  # zero or more operators"
    echo "  4. bai viewer add <UID>    # zero or more viewers"
    echo "  5. bai validate            # sanity-check the config"
    echo "  6. bai reload              # ask the gateway to pick up the changes"
  fi

  trap - RETURN
}

# --- subcommand: <tier> add / remove / list ---

# tier_add <tier> <uid> [name]
#
# Set-semantics: the user ends up in exactly one tier (the target). If they
# were in another tier already, they are removed from it. Idempotent re-runs
# are noops. ownerAllowFrom is added iff the target tier is admins, and is
# removed otherwise (handles the demote-via-add case).
tier_add() {
  local tier="$1" uid="$2" name="${3:-}"
  validate_user_id "$uid"
  require_config
  local agent="${TIER_AGENT[$tier]}"
  local prefixed
  prefixed="$(prefixed_slack_id "$uid")"

  # Sync-channels-slack-allowFrom helper: regenerate as the union of all
  # tier accessGroup members. Some OpenClaw builds do NOT expand
  # "accessGroup:" references in channels.slack.allowFrom at runtime,
  # which silently blocks all DMs. Listing literal user IDs always works.
  # We re-derive this after every add/remove.

  # Detect existing tier(s) before mutating, for the report.
  local previous=""
  for t in "${TIERS[@]}"; do
    if [[ "$t" != "$tier" ]] && jq -e --arg t "$t" --arg u "$uid" \
         '(.accessGroups[$t].members.slack // []) | index($u)' "$CONFIG_FILE" >/dev/null
    then
      previous="${previous:+$previous, }${TIER_LABEL[$t]}"
    fi
  done

  write_json '
    # 1. Remove from every other tier (admins/operators/viewers ∖ {target}).
      reduce (["admins","operators","viewers"] - [$tier])[] as $t (
        .;
        .accessGroups[$t].members.slack |= ((. // []) | map(select(. != $uid)))
      )
    # 2. Add to target tier.
    | .accessGroups[$tier].members.slack |= ((. // []) + [$uid] | unique)
    # 3. ownerAllowFrom: add iff target is admins, remove otherwise (covers
    #    the case where we are demoting an existing admin via a re-add to
    #    a lower tier).
    | (if $tier == "admins"
        then .commands.ownerAllowFrom |= ((. // []) + [$prefixed] | unique)
        else .commands.ownerAllowFrom |= ((. // []) | map(select(. != $prefixed)))
       end)
    # 4. Strip every per-user DM binding for this UID (any agent), then
    #    insert the canonical one for the target tier at the front of the
    #    bindings list (first-match-wins precedence).
    | .bindings |= ((. // []) | map(select(
        (.match.peer.kind // "") != "direct"
        or (.match.peer.id // "") != $uid
      )))
    | .bindings |= [{
        agentId: $agent,
        match: { channel: "slack", peer: { kind: "direct", id: $uid } }
      }] + .
    # Sync channels.slack.allowFrom to the union of all tier members
    # (literal IDs only — accessGroup: refs may not expand at runtime).
    | .channels.slack.allowFrom = (
        ((.accessGroups.admins.members.slack    // []) +
         (.accessGroups.operators.members.slack // []) +
         (.accessGroups.viewers.members.slack   // []))
        | unique)
  ' \
    --arg tier     "$tier" \
    --arg uid      "$uid" \
    --arg agent    "$agent" \
    --arg prefixed "$prefixed"

  local label="${TIER_LABEL[$tier]}"
  local who="${name:+$name }($uid)"
  who="${who:-$uid}"
  if [[ -n "$previous" ]]; then
    echo "bai: set $who tier to $label (was: $previous)"
  else
    echo "bai: set $who tier to $label"
  fi
  echo "  → accessGroup:$tier"
  echo "  → bindings: DM peer:direct:$uid → $agent"
  if [[ "$tier" == "admins" ]]; then
    echo "  → commands.ownerAllowFrom: $prefixed"
    echo "  Reminder: invite $uid to #base-ai-admin, #base-ai-ops, #base-ai-ask"
  elif [[ "$tier" == "operators" ]]; then
    echo "  Reminder: invite $uid to #base-ai-ops, #base-ai-ask"
    if [[ "$previous" == *"Admin"* ]]; then
      echo "  Reminder: also kick $uid from #base-ai-admin (demotion)"
    fi
  else
    echo "  Reminder: invite $uid to #base-ai-ask"
    if [[ "$previous" == *"Admin"* ]]; then
      echo "  Reminder: also kick $uid from #base-ai-admin and #base-ai-ops (demotion)"
    elif [[ "$previous" == *"Operator"* ]]; then
      echo "  Reminder: also kick $uid from #base-ai-ops (demotion)"
    fi
  fi
}

tier_remove() {
  local tier="$1" uid="$2"
  validate_user_id "$uid"
  require_config
  local agent="${TIER_AGENT[$tier]}"
  local prefixed
  prefixed="$(prefixed_slack_id "$uid")"

  write_json '
    .accessGroups[$tier].members.slack |= ((. // []) | map(select(. != $uid)))
    | (if $tier == "admins"
        then .commands.ownerAllowFrom |= ((. // []) | map(select(. != $prefixed)))
        else .
       end)
    | .bindings |= ((. // []) | map(select(
        .agentId != $agent
        or (.match.peer.kind // "") != "direct"
        or (.match.peer.id // "")   != $uid
      )))
    # Re-sync channels.slack.allowFrom to the remaining union of all tiers.
    | .channels.slack.allowFrom = (
        ((.accessGroups.admins.members.slack    // []) +
         (.accessGroups.operators.members.slack // []) +
         (.accessGroups.viewers.members.slack   // []))
        | unique)
  ' \
    --arg tier     "$tier" \
    --arg uid      "$uid" \
    --arg agent    "$agent" \
    --arg prefixed "$prefixed"

  local label="${TIER_LABEL[$tier]}"
  echo "bai: removed $uid from $label tier"
  echo "  Reminder: also kick $uid from the corresponding Slack channels"
}

tier_list() {
  local tier="$1"
  require_config
  local count
  count="$(jq -r --arg t "$tier" '.accessGroups[$t].members.slack // [] | length' "$CONFIG_FILE")"
  echo "${TIER_LABEL[$tier]} tier ($count member$([[ $count -eq 1 ]] || echo s)):"
  if [[ "$count" -eq 0 ]]; then
    echo "  (none)"
    return
  fi
  jq -r --arg t "$tier" '.accessGroups[$t].members.slack[] | "  \(.)"' "$CONFIG_FILE"
}

# --- subcommand: whois <uid> ---

cmd_whois() {
  local uid="${1:?usage: bai whois <UID>}"
  validate_user_id "$uid"
  require_config

  local prefixed
  prefixed="$(prefixed_slack_id "$uid")"

  local found=0
  for tier in "${TIERS[@]}"; do
    if jq -e --arg t "$tier" --arg u "$uid" \
        '(.accessGroups[$t].members.slack // []) | index($u)' "$CONFIG_FILE" >/dev/null
    then
      echo "  ${TIER_LABEL[$tier]} (accessGroup:$tier)"
      found=1
    fi
  done

  if jq -e --arg p "$prefixed" '(.commands.ownerAllowFrom // []) | index($p)' "$CONFIG_FILE" >/dev/null; then
    echo "  Owner (commands.ownerAllowFrom)"
    found=1
  fi

  local bindings
  bindings="$(jq -r --arg u "$uid" '
    [.bindings[]?
     | select((.match.peer.kind // "") == "direct" and (.match.peer.id // "") == $u)
     | "  DM binding → " + .agentId
    ] | .[]
  ' "$CONFIG_FILE")"
  if [[ -n "$bindings" ]]; then
    echo "$bindings"
    found=1
  fi

  if [[ $found -eq 0 ]]; then
    echo "$uid is not in any tier."
  fi
}

# --- subcommand: tiers ---

cmd_tiers() {
  require_config
  printf "%-10s %-12s %s\n" "TIER" "AGENT" "MEMBERS"
  printf "%-10s %-12s %s\n" "----" "-----" "-------"
  for tier in "${TIERS[@]}"; do
    local count
    count="$(jq -r --arg t "$tier" '.accessGroups[$t].members.slack // [] | length' "$CONFIG_FILE")"
    printf "%-10s %-12s %s\n" "${TIER_LABEL[$tier]}" "${TIER_AGENT[$tier]}" "$count"
  done
}

# --- subcommand: validate ---

cmd_validate() {
  require_config
  local errors=0

  echo "bai: validating $CONFIG_FILE"

  # Structural sanity checks (any failure increments $errors but continues).
  for tier in "${TIERS[@]}"; do
    if ! jq -e --arg t "$tier" '.accessGroups[$t].members.slack' "$CONFIG_FILE" >/dev/null; then
      echo "  ✗ accessGroups.$tier.members.slack missing"
      errors=$((errors + 1))
    fi
  done

  for agent in admin ops view; do
    if ! jq -e --arg a "$agent" '.agents.list[] | select(.id == $a)' "$CONFIG_FILE" >/dev/null; then
      echo "  ✗ agents.list missing entry for '$agent'"
      errors=$((errors + 1))
    fi
  done

  if jq -e '[.. | strings | select(test("REPLACE_WITH"))] | length > 0' "$CONFIG_FILE" >/dev/null; then
    local placeholders
    placeholders="$(jq -r '[.. | strings | select(test("REPLACE_WITH"))] | unique | .[]' "$CONFIG_FILE")"
    echo "  ⚠ unfilled placeholder(s):"
    echo "$placeholders" | sed 's/^/      /'
    errors=$((errors + 1))
  fi

  # Sanity: per-user DM bindings should reference the tier's agent for that user.
  for tier in "${TIERS[@]}"; do
    local agent="${TIER_AGENT[$tier]}"
    local mismatched
    mismatched="$(jq -r --arg t "$tier" --arg a "$agent" '
      (.accessGroups[$t].members.slack // []) as $members
      | [.bindings[]?
         | select((.match.peer.kind // "") == "direct"
                  and (.match.peer.id // "") as $id
                      | ($members | index($id)) != null
                  and .agentId != $a)
         | .match.peer.id
        ] | .[]
    ' "$CONFIG_FILE")"
    if [[ -n "$mismatched" ]]; then
      echo "  ✗ $tier members with wrong-tier DM binding: $mismatched"
      errors=$((errors + 1))
    fi
  done

  # Sanity: no user should be in more than one tier (set-semantics on add).
  local dupes
  dupes="$(jq -r '
    [((.accessGroups // {}) | to_entries[])
     | .key as $t
     | (.value.members.slack // [])[] as $u
     | {tier: $t, uid: $u}]
    | group_by(.uid)
    | map(select(length > 1))
    | .[]
    | "\(.[0].uid) in \(map(.tier) | join(", "))"
  ' "$CONFIG_FILE")"
  if [[ -n "$dupes" ]]; then
    echo "  ✗ user(s) in multiple tiers (run 'bai <tier> add' to set canonically):"
    echo "$dupes" | sed 's/^/      /'
    errors=$((errors + 1))
  fi

  if [[ $errors -eq 0 ]]; then
    echo "  ✓ all checks passed"
  else
    echo "  $errors issue(s) found"
    return 1
  fi
}

# --- subcommand: migrate ---
#
# One-shot fixup for configs that were written against the older skeleton or
# the older OpenClaw schema. Idempotent — safe to run multiple times. Always
# writes a timestamped backup before mutating.
#
# What it does:
#   1. Renames agent IDs base-admin/base-ops/base-view → admin/ops/view
#      (and rewrites bindings[].agentId to match).
#   2. Rewrites workspace paths from /home/ubuntu/.openclaw/... → ~/.openclaw/...
#      so the path resolves correctly inside the container.
#   3. agents.list[].systemPrompt → systemPromptOverride.
#   4. agents.default (string, invalid) → "default": true on the matching entry.
#   5. commands.ownerDisplaySecret: object → string placeholder.
#   6. channels.slack.botToken / appToken: {secret: X} → SecretRef env form.
#   7. channels.slack.execApprovals.enabled "auto" → omitted (zod only accepts boolean).
#   8. tools.allow/deny: replace bare "memory" (section label, not a tool) with "group:memory".
#   9. channels.slack.channels.<id>.users: strip "accessGroup:*" entries
#      (the slack channel gate doesn't expand them; they'd silently reject all users).
#
# Does NOT do: openclaw's own legacy renames (chunkMode → streaming.chunkMode,
# channels.<id>.allow → enabled, etc.). Run `openclaw doctor --fix` separately
# for those.
cmd_migrate() {
  require_config
  local backup="$CONFIG_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  cp "$CONFIG_FILE" "$backup"

  write_json '
      .agents.list = ((.agents.list // []) | map(.id |= sub("^base-"; "")))
    | .bindings    = ((.bindings   // []) | map(.agentId |= sub("^base-"; "")))
    | .agents.list = (.agents.list | map(
        if (.workspace // null | type) == "string"
        then .workspace |= sub("^/home/ubuntu/.openclaw/"; "~/.openclaw/")
        else . end))
    | .agents.list = (.agents.list | map(
        if has("systemPrompt")
        then .systemPromptOverride = .systemPrompt | del(.systemPrompt)
        else . end))
    | (.agents.default // null) as $def
    | if $def != null then ($def | sub("^base-"; "")) as $d
        | .agents.list = (.agents.list | map(if .id == $d then .default = true else . end))
        | del(.agents.default)
      else . end
    | if (.commands.ownerDisplaySecret // null | type) == "object"
      then .commands.ownerDisplaySecret = "REPLACE_WITH_OWNER_DISPLAY_HMAC_KEY"
      else . end
    # botToken / appToken: leave the value alone here. We will INLINE the
    # real token string from the container env vars in a post-jq step below
    # (literal strings are the only form OpenClaw resolves reliably across
    # builds — env-substitution "${VAR}" and {source:"env",...} SecretRef
    # both depend on machinery that this Minimus build does not always wire).
    # The post-step pulls SLACK_BOT_TOKEN / SLACK_APP_TOKEN from the running
    # gateway container and replaces any object/placeholder values.
    | if (.channels.slack.execApprovals.enabled // null) == "auto"
      then .channels.slack.execApprovals |= del(.enabled)
      else . end
    | .agents.list = (.agents.list | map(
        (if .tools.allow then .tools.allow |= map(if . == "memory" then "group:memory" else . end) else . end)
        | (if .tools.deny then .tools.deny |= map(if . == "memory" then "group:memory" else . end) else . end)))
    | .channels.slack.channels = ((.channels.slack.channels // {}) | with_entries(
        .value.users = ((.value.users // []) | map(select(
          type != "string" or (startswith("accessGroup:") | not)
        )))
        | if (.value.users | length) == 0 then .value |= del(.users) else . end))
    # 10. accessGroups.<name>.type: force to "message.senders" (the only sensible
    #     value for Slack/Telegram/cross-channel use; the zod discriminator only
    #     accepts "message.senders" | "discord.channelAudience").
    | .accessGroups = ((.accessGroups // {}) | with_entries(
        .value.type = "message.senders"))
    # 10b. channels.slack.allowFrom: replace "accessGroup:*" refs with the
    #      literal union of all tier members. Some builds do not expand the
    #      "accessGroup:" tokens at runtime in the slack DM allowlist gate,
    #      which silently rejects every DM. Literal IDs always work.
    | if (.channels.slack.allowFrom // [] | map(select(type == "string" and startswith("accessGroup:"))) | length) > 0
      then .channels.slack.allowFrom = (
        ((.accessGroups.admins.members.slack    // []) +
         (.accessGroups.operators.members.slack // []) +
         (.accessGroups.viewers.members.slack   // []))
        | unique)
      else . end
    # 11. Ensure the three tier agents exist. Append any of admin/ops/view that
    #     are missing — with the same shapes as the init skeleton. Existing
    #     entries (whatever the user has tweaked) are kept untouched.
    # NOTE: workspace + agentDir directory creation happens AFTER the jq pass,
    #       in the bash wrapper. See the post-write hook in cmd_migrate.
    | (.agents.list // []) as $current
    | (
        [
          {
            id: "admin",
            workspace: "~/.openclaw/workspace-admin",
            sandbox: { mode: "off" },
            tools: {
              allow: ["read","write","edit","exec","apply_patch","browser","sessions_send","group:memory"],
              elevated: { enabled: true }
            },
            systemPromptOverride: "admin: full operator-tier agent for the org. Never assume a sender is an admin without verifying their Slack user ID against the admins accessGroup."
          },
          {
            id: "ops",
            workspace: "~/.openclaw/workspace-ops",
            sandbox: { mode: "all", scope: "agent", workspaceAccess: "rw" },
            tools: {
              allow: ["read","write","edit","browser","sessions_send","group:memory"],
              deny: ["exec","apply_patch","gateway","cron"]
            },
            systemPromptOverride: "ops: workflow-automation tier. You can draft, file, and update — but never exec shell, apply patches, or modify gateway config."
          },
          {
            id: "view",
            default: true,
            workspace: "~/.openclaw/workspace-view",
            sandbox: { mode: "all", scope: "agent", workspaceAccess: "ro" },
            tools: {
              allow: ["read","browser","group:memory"],
              deny: ["write","edit","exec","apply_patch","sessions_send","gateway","cron"]
            },
            systemPromptOverride: "view: read-only research/lookup tier. Refuse any state-mutating request and suggest opening a ticket via #base-ai-ops instead."
          }
        ] | map(select(.id as $id | ($current | map(.id) | index($id)) == null))
      ) as $missing
    | .agents.list = ($current + $missing)
  '

  # Create workspace + agentDir on disk for any agent that has a tilde-form
  # workspace path. Some UI surfaces appear to require the dirs to exist
  # before listing the agent (the agent runtime mkdirs them on first
  # invocation, but the listing path doesn't trigger that). Cheap to create
  # eagerly here.
  local agents_root="$HOME/.openclaw/agents"
  local workspace_root="$HOME/.openclaw"
  while read -r agent_id; do
    [[ -z "$agent_id" ]] && continue
    mkdir -p "$agents_root/$agent_id/agent"
  done < <(jq -r '.agents.list[]?.id // empty' "$CONFIG_FILE")

  while read -r ws_path; do
    [[ -z "$ws_path" ]] && continue
    # Only expand ~ and ~/ forms; leave absolute paths alone (they may point
    # somewhere the script user can't write).
    case "$ws_path" in
      "~"|"~/"*) mkdir -p "${ws_path/#~/$HOME}" ;;
      *) : ;;
    esac
  done < <(jq -r '.agents.list[]?.workspace // empty' "$CONFIG_FILE")

  echo "bai: migrated $CONFIG_FILE"
  echo "     backup: $backup"
  echo "     agentDirs + workspaces ensured on disk"
  echo
  echo "Next:"
  echo "  1. Run 'openclaw doctor --fix' for the gateway-side legacy renames"
  echo "     (chunkMode → streaming.chunkMode, channels.<id>.allow → enabled, etc.)"
  echo "  2. Set a real value for commands.ownerDisplaySecret (or use raw mode):"
  echo "     For hash mode: SECRET=\$(openssl rand -hex 32); \\"
  echo "       jq --arg s \"\$SECRET\" '.commands.ownerDisplaySecret = \$s' \\"
  echo "         $CONFIG_FILE > /tmp/o.json && mv /tmp/o.json $CONFIG_FILE"
  echo "     For raw mode: jq '.commands.ownerDisplay = \"raw\" | del(.commands.ownerDisplaySecret)' \\"
  echo "       $CONFIG_FILE > /tmp/o.json && mv /tmp/o.json $CONFIG_FILE"
  echo "  3. bai validate"
  echo "  4. openclaw gateway restart (or: bai reload)"
}

# --- subcommand: bootstrap ---
#
# Bootstraps the three tier agents (admin/ops/view) so they show up in the UI.
# Just writing them to openclaw.json isn't enough — the UI requires the
# workspace bootstrap files (AGENTS.md, SOUL.md, TOOLS.md, IDENTITY.md,
# USER.md, HEARTBEAT.md, BOOTSTRAP.md) plus the sessions dir. The only
# supported way to create these is `openclaw agents add` (which both writes
# the config and runs ensureWorkspaceAndSessions).
#
# This command shells out to `openclaw agents add <id>` for each tier agent
# already present in agents.list. The openclaw CLI sees the entry exists and
# offers an interactive "Update it?" prompt — accept with 'y' and Enter
# through the remaining defaults.
#
# Idempotent: bootstrap files survive re-runs; the openclaw CLI is smart
# enough to not duplicate them.
cmd_bootstrap() {
  require_config
  command -v openclaw >/dev/null 2>&1 || die "the 'openclaw' CLI must be on PATH (see walkthrough §6a)"

  echo "bai: running 'openclaw agents add' interactively for each tier agent."
  echo "     At each prompt:"
  echo "       'Agent ... already exists. Update it?'  → answer y"
  echo "       'Workspace directory'                   → press Enter (accept default)"
  echo "       'Configure model/auth for this agent now?' → answer n"
  echo "     (any other prompts: accept defaults / decline)"
  echo
  for agent in admin ops view; do
    if ! jq -e --arg a "$agent" '.agents.list[] | select(.id == $a)' "$CONFIG_FILE" >/dev/null; then
      echo "bai: $agent not in agents.list — run 'bai migrate' first"
      continue
    fi
    echo "─── $agent ───"
    openclaw agents add "$agent" || die "openclaw agents add $agent failed"
    echo
  done

  # 'openclaw agents add' stamps each new agent with the wizard's default
  # model (often claude-opus-4-6), which overrides whatever global default
  # is actually configured in litellm. That's the most common cause of
  # "agent registered but never responds". Strip those explicit overrides
  # so the tier agents inherit the same model as 'main'.
  echo "bai: stripping per-agent model overrides on tier agents (inherit global default)"
  write_json '
    .agents.list |= map(
      if (.id == "admin" or .id == "ops" or .id == "view")
      then del(.model) else . end
    )
  '

  echo
  echo "bai: bootstrap done."
  echo "     Restart the gateway to pick up the new workspace files + agent registrations:"
  echo "     bai reload      # full container restart (recommended)"
}

# --- subcommand: reload ---
#
# Validates the local config, then restarts the gateway container. We default
# to a full `docker compose restart openclaw-gateway` because `openclaw config
# reload` (the hot path) doesn't reliably re-initialize agent registrations
# after agents.list changes — a learned-the-hard-way gotcha. The container
# restart is ~10s of downtime and is what actually picks up new agents.
#
# Pass --hot to attempt the in-process config reload instead. Use that for
# tier/binding/accessGroup changes that don't add or remove agents.
cmd_reload() {
  local mode="restart"
  if [[ "${1:-}" == "--hot" ]]; then mode="hot"; shift; fi

  require_config

  echo "bai: validating before reload..."
  cmd_validate || die "validation failed — fix issues before reloading"

  if [[ "$mode" == "hot" ]]; then
    command -v openclaw >/dev/null 2>&1 || die "the 'openclaw' shim is required for --hot reload"
    echo "bai: openclaw config reload (hot — won't re-init new agents)"
    openclaw config reload || die "hot reload failed; try 'bai reload' for a full restart"
    echo "bai: hot-reload done"
    return 0
  fi

  if [[ -f "$COMPOSE_DIR/docker-compose.yml" ]]; then
    echo "bai: docker compose restart openclaw-gateway (in $COMPOSE_DIR)"
    (cd "$COMPOSE_DIR" && \
       docker compose -f docker-compose.yml -f docker-compose.prod.yml restart openclaw-gateway)
    echo "bai: reload done (gateway fully restarted)"
    return 0
  fi

  die "no docker-compose dir at $COMPOSE_DIR — set BAI_COMPOSE_DIR or restart manually"
}

# --- subcommand: path ---

cmd_path() { echo "$CONFIG_FILE"; }

# --- subcommand: help ---

cmd_help() {
  sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'
}

# --- dispatch ---

require_jq

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)               cmd_init "$@" ;;
  admin)
    sub="${1:?usage: bai admin add|remove|list ...}"; shift
    case "$sub" in
      add)            tier_add admins "$@" ;;
      remove|rm|del)  tier_remove admins "$@" ;;
      list|ls)        tier_list admins ;;
      *)              die "unknown 'admin' subcommand: $sub" ;;
    esac
    ;;
  operator|op)
    sub="${1:?usage: bai operator add|remove|list ...}"; shift
    case "$sub" in
      add)            tier_add operators "$@" ;;
      remove|rm|del)  tier_remove operators "$@" ;;
      list|ls)        tier_list operators ;;
      *)              die "unknown 'operator' subcommand: $sub" ;;
    esac
    ;;
  viewer|view)
    sub="${1:?usage: bai viewer add|remove|list ...}"; shift
    case "$sub" in
      add)            tier_add viewers "$@" ;;
      remove|rm|del)  tier_remove viewers "$@" ;;
      list|ls)        tier_list viewers ;;
      *)              die "unknown 'viewer' subcommand: $sub" ;;
    esac
    ;;
  whois)              cmd_whois "$@" ;;
  tiers)              cmd_tiers ;;
  validate|check)     cmd_validate ;;
  migrate)            cmd_migrate ;;
  bootstrap)          cmd_bootstrap ;;
  reload)             cmd_reload ;;
  path)               cmd_path ;;
  -h|--help|help)     cmd_help ;;
  *)                  die "unknown command '$cmd' (try: bai help)" ;;
esac
