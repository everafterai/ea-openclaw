#!/usr/bin/env bash
# lc — LiteLLM control shim for the dockerized litellm sidecar.
#
# Container management:
#   lc                     # status (alias for `lc ps`)
#   lc ps                  # container status
#   lc logs [args...]      # follow logs (passes args to `docker logs`)
#   lc restart             # restart container (config file changes only)
#   lc reload              # alias for `lc restart`
#   lc recreate            # `dcp up -d --force-recreate litellm` — pick up
#                          # changes to .env / docker-compose.prod.yml that
#                          # restart can't see (env vars are baked at create)
#   lc edit                # edit deploy/litellm/config.yaml then restart
#   lc shell               # open a shell inside the container
#
# HTTP helpers (auto-inject the master key from .env):
#   lc health              # GET /health/liveliness
#   lc ready               # GET /health/readiness
#   lc models              # GET /v1/models
#   lc test <model> [msg]  # POST /v1/chat/completions (default msg: "Hello")
#   lc curl <path> [args]  # arbitrary authenticated GET against the proxy
#
# Spend tracking (requires DATABASE_URL configured — see compose):
#   lc spend               # today's totals + per-model breakdown
#   lc spend today         # alias for `lc spend`
#   lc spend month         # month-to-date daily breakdown
#   lc spend range <s> <e> # daily breakdown, dates YYYY-MM-DD
#   lc spend report [s] [e]# /global/spend/report (default: MTD, by api_key)
#   lc spend logs [s] [e]  # individual /spend/logs rows (default: today)
#   lc spend raw [s] [e]   # raw /user/daily/activity JSON dump
#
# Raw passthrough:
#   lc exec <cmd...>       # docker exec into the litellm container
#   lc cli <litellm-args>  # run `litellm` CLI inside the container
#
# Requires:
#   - docker on PATH
#   - run from anywhere; resolves repo root from script location
#   - .env in the repo root with LITELLM_MASTER_KEY=...

set -euo pipefail

# --- locate repo + container ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONTAINER="${LITELLM_CONTAINER:-ea-openclaw-litellm-1}"
CONFIG_FILE="$REPO_DIR/deploy/litellm/config.yaml"
ENV_FILE="$REPO_DIR/.env"

# --- load master key from .env (no value leaks to logs) ---
load_key() {
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "lc: .env not found at $ENV_FILE" >&2
    exit 1
  fi
  KEY="$(grep -E '^LITELLM_MASTER_KEY=' "$ENV_FILE" | head -1 | cut -d= -f2-)"
  if [[ -z "${KEY:-}" ]]; then
    echo "lc: LITELLM_MASTER_KEY not set in $ENV_FILE" >&2
    exit 1
  fi
}

# --- helpers ---
ensure_running() {
  if ! docker inspect "$CONTAINER" --format '{{.State.Status}}' 2>/dev/null | grep -qx running; then
    echo "lc: container '$CONTAINER' is not running" >&2
    docker ps -a --filter "name=$CONTAINER" || true
    exit 1
  fi
}

today_utc()      { date -u +%Y-%m-%d; }
month_start_utc(){ date -u +%Y-%m-01; }

http_get() {
  local path="$1"; shift || true
  load_key
  ensure_running
  # The litellm image is python-only (no curl). Use urllib instead.
  docker exec -e LC_KEY="$KEY" -e LC_PATH="$path" "$CONTAINER" python -c '
import os, sys, urllib.request
req = urllib.request.Request(
    "http://127.0.0.1:4000" + os.environ["LC_PATH"],
    headers={"Authorization": "Bearer " + os.environ["LC_KEY"]},
)
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        sys.stdout.write(r.read().decode("utf-8", "replace"))
        sys.stdout.write("\n")
except urllib.error.HTTPError as e:
    sys.stderr.write(f"HTTP {e.code} {e.reason}\n")
    sys.stderr.write(e.read().decode("utf-8", "replace") + "\n")
    sys.exit(1)
except Exception as e:
    sys.stderr.write(f"error: {e}\n"); sys.exit(1)
'
}

http_post_json() {
  local path="$1"; shift
  local body="$1"; shift
  load_key
  ensure_running
  docker exec -e LC_KEY="$KEY" -e LC_PATH="$path" -e LC_BODY="$body" "$CONTAINER" python -c '
import os, sys, urllib.request
req = urllib.request.Request(
    "http://127.0.0.1:4000" + os.environ["LC_PATH"],
    data=os.environ["LC_BODY"].encode("utf-8"),
    headers={
        "Authorization": "Bearer " + os.environ["LC_KEY"],
        "Content-Type": "application/json",
    },
    method="POST",
)
try:
    with urllib.request.urlopen(req, timeout=120) as r:
        sys.stdout.write(r.read().decode("utf-8", "replace"))
        sys.stdout.write("\n")
except urllib.error.HTTPError as e:
    sys.stderr.write(f"HTTP {e.code} {e.reason}\n")
    sys.stderr.write(e.read().decode("utf-8", "replace") + "\n")
    sys.exit(1)
except Exception as e:
    sys.stderr.write(f"error: {e}\n"); sys.exit(1)
'
}

# Format /user/daily/activity JSON (read from stdin) into a readable
# per-day + per-model table. Uses `python3 -c` so the script source does
# not consume stdin — the JSON pipe must remain available to sys.stdin.
# Avoids f-string quote escaping by using str.format throughout (the outer
# shell layer is single-quoted).
format_daily_activity() {
  python3 -c '
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    print("(empty response)"); sys.exit(0)
try:
    data = json.loads(raw)
except Exception:
    print(raw); sys.exit(0)

results = data.get("results") or []
meta = data.get("metadata") or {}

if not results:
    print("No spend recorded in this range.")
    print("(If you expected data: confirm DATABASE_URL is set and that")
    print(" requests have run since the DB was wired in.)")
    sys.exit(0)

def usd(x): return "${:,.4f}".format(float(x))
def num(x): return "{:,}".format(int(x))

ROW = "{:<12}{:>12}{:>12}{:>14}{:>14}"
print(ROW.format("Date","Spend","Requests","Prompt tok","Compl tok"))
print("-" * 64)
for row in results:
    m = row.get("metrics") or {}
    print(ROW.format(
        row.get("date",""),
        usd(m.get("spend",0)),
        num(m.get("api_requests",0)),
        num(m.get("prompt_tokens",0)),
        num(m.get("completion_tokens",0)),
    ))
print("-" * 64)
print(ROW.format(
    "TOTAL",
    usd(meta.get("total_spend",0)),
    num(meta.get("total_api_requests",0)),
    num(meta.get("total_prompt_tokens",0)),
    num(meta.get("total_completion_tokens",0)),
))

models_total = {}
for row in results:
    bd = (row.get("breakdown") or {}).get("models") or {}
    for name, info in bd.items():
        metrics = info.get("metrics") if isinstance(info, dict) else None
        if metrics is None and isinstance(info, dict):
            metrics = info
        if not isinstance(metrics, dict):
            continue
        agg = models_total.setdefault(name, {"spend": 0.0, "req": 0})
        agg["spend"] += float(metrics.get("spend", 0) or 0)
        agg["req"]   += int(metrics.get("api_requests", 0) or 0)

if models_total:
    print()
    MROW = "{:<40}{:>12}{:>12}"
    print(MROW.format("Model","Spend","Requests"))
    print("-" * 64)
    for name, agg in sorted(models_total.items(), key=lambda kv: -kv[1]["spend"]):
        print(MROW.format(name[:40], usd(agg["spend"]), num(agg["req"])))
'
}

# --- subcommands ---
cmd="${1:-ps}"
shift || true

case "$cmd" in
  ps|status)
    docker ps --filter "name=$CONTAINER"
    ;;
  logs)
    exec docker logs "$@" "$CONTAINER"
    ;;
  restart|reload)
    docker restart "$CONTAINER"
    ;;
  recreate)
    # Use compose so .env + compose-file env vars are re-evaluated.
    cd "$REPO_DIR"
    docker compose -f docker-compose.yml -f docker-compose.prod.yml \
      up -d --force-recreate litellm
    ;;
  edit)
    "${EDITOR:-nano}" "$CONFIG_FILE"
    echo "Restarting litellm to pick up config..."
    docker restart "$CONTAINER"
    ;;
  shell|sh)
    ensure_running
    exec docker exec -it "$CONTAINER" sh
    ;;
  health)
    http_get /health/liveliness ;;
  ready|readiness)
    http_get /health/readiness ;;
  models)
    http_get /v1/models | python3 -m json.tool 2>/dev/null || true
    ;;
  spend)
    sub="${1:-today}"; shift || true
    case "$sub" in
      today)
        d="$(today_utc)"
        http_get "/user/daily/activity?start_date=${d}&end_date=${d}" | format_daily_activity
        ;;
      month)
        s="$(month_start_utc)"; e="$(today_utc)"
        http_get "/user/daily/activity?start_date=${s}&end_date=${e}" | format_daily_activity
        ;;
      range)
        s="${1:-}"; e="${2:-}"
        if [[ -z "$s" || -z "$e" ]]; then
          echo "Usage: lc spend range <YYYY-MM-DD> <YYYY-MM-DD>" >&2; exit 2
        fi
        http_get "/user/daily/activity?start_date=${s}&end_date=${e}" | format_daily_activity
        ;;
      report)
        s="${1:-$(month_start_utc)}"; e="${2:-$(today_utc)}"
        http_get "/global/spend/report?start_date=${s}&end_date=${e}&group_by=api_key" \
          | python3 -m json.tool 2>/dev/null || true
        ;;
      logs)
        s="${1:-$(today_utc)}"; e="${2:-$(today_utc)}"
        http_get "/spend/logs?start_date=${s}&end_date=${e}" \
          | python3 -m json.tool 2>/dev/null || true
        ;;
      raw)
        s="${1:-$(today_utc)}"; e="${2:-$(today_utc)}"
        http_get "/user/daily/activity?start_date=${s}&end_date=${e}" \
          | python3 -m json.tool 2>/dev/null || true
        ;;
      -h|--help|help)
        sed -n '/^# Spend tracking/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
        ;;
      *)
        echo "lc spend: unknown subcommand '$sub' (try: today, month, range, report, logs, raw)" >&2
        exit 2
        ;;
    esac
    ;;
  test)
    model="${1:-}"; shift || true
    msg="${*:-Hello — what model are you?}"
    if [[ -z "$model" ]]; then
      echo "Usage: lc test <model> [message]" >&2
      exit 2
    fi
    # JSON-encode model + msg via python (handles quotes/unicode safely)
    body=$(python3 -c '
import json, sys
print(json.dumps({"model": sys.argv[1], "messages": [{"role": "user", "content": sys.argv[2]}]}))
' "$model" "$msg")
    http_post_json /v1/chat/completions "$body" | python3 -m json.tool 2>/dev/null || true
    ;;
  curl)
    path="${1:-/}"; shift || true
    http_get "$path" "$@"
    ;;
  exec)
    ensure_running
    exec docker exec -it "$CONTAINER" "$@"
    ;;
  cli)
    ensure_running
    exec docker exec -it "$CONTAINER" litellm "$@"
    ;;
  -h|--help|help)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "lc: unknown command '$cmd' (try: lc help)" >&2
    exit 2
    ;;
esac
