  "agents": {
    "list": [
      {
        "id": "main",
        "name": "main",
        "workspace": "/home/node/.openclaw/workspace",
        "agentDir": "/home/node/.openclaw/agents/main/agent"
      },
      {
        "id": "admin",
        "workspace": "~/.openclaw/workspace-admin",
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": [
            "browser",
            "message",
            "group:plugins"
          ],
          "elevated": {
            "enabled": true
          }
        },
        "systemPromptOverride": "admin: full operator-tier agent for the org. Never assume a sender is an admin without verifying their Slack user ID against the admins accessGroup.",
        "name": "admin",
        "agentDir": "/home/node/.openclaw/agents/admin/agent"
      },
      {
        "id": "ops",
        "workspace": "~/.openclaw/workspace-ops",
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": [
            "browser",
            "message",
            "group:plugins"
          ],
          "deny": [
            "exec",
            "apply_patch",
            "gateway",
            "cron"
          ]
        },
        "systemPromptOverride": "ops: workflow-automation tier. You can draft, file, and update — but never exec shell, apply patches, or modify gateway config.",
        "name": "ops",
        "agentDir": "/home/node/.openclaw/agents/ops/agent"
      },
      {
        "id": "view",
        "default": true,
        "workspace": "~/.openclaw/workspace-view",
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "allow": [
            "read",
            "browser",
            "group:web",
            "group:memory",
            "sessions_list",
            "sessions_history",
            "session_status"
          ],
          "deny": [
            "write",
            "edit",
            "exec",
            "apply_patch",
            "sessions_send",
            "gateway",
            "cron"
          ]
        },
        "systemPromptOverride": "view: read-only research/lookup tier. Refuse any state-mutating request and suggest opening a ticket via #base-ai-ops instead.",
        "name": "view",
        "agentDir": "/home/node/.openclaw/agents/view/agent"
      }
    ],
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "litellm/gemini-3.1-pro-preview"
      },
