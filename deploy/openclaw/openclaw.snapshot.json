          "enabled": true,
          "requireMention": true,
          "systemPrompt": "You are in #base-ai-ops. No exec, no apply_patch — refuse and suggest DMing an admin."
        },
        "REPLACE_WITH_ASK_CHANNEL_ID": {
          "enabled": true,
          "requireMention": true,
          "systemPrompt": "You are in #base-ai-ask. Read-only Q&A on. Refuse write requests and link to #base-ai-ops."
        }
      },
      "execApprovals": {
        "approvers": [
          "accessGroup:admins"
        ],
        "target": "dm"
      },
      "ackReaction": "eyes",
      "typingReaction": "hourglass_flowing_sand",
      "enabled": true
    }
